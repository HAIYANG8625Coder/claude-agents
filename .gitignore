# Personal: stays on this laptop only (see x-assistant/voice.example.md)
x-assistant/voice.md

# Generated template samples (re-render any time)
x-assistant/images/sample-*

# Secrets — never commit
.env
.env.*
*.pem
*.key
**/credentials*
.claude/settings.local.json

# OS / editor noise
.DS_Store
*.swp

# Global Claude rules stay local (never commit)
global/

# Avatar video: personal media and HeyGen ids stay on this laptop
AVATAR-*.md
avatar-video/node_modules/
avatar-video/videos/*/
!avatar-video/videos/.gitkeep
avatar-video/**/.hyperframes/
avatar-video/**/renders/
avatar-video/**/*.mp4
avatar-video/**/*.mp3
avatar-video/**/*.wav
avatar-video/**/*.m4a
avatar-video/**/*.mov
avatar-video/.venv/
avatar-video/.venv-tts/
avatar-video/voice-samples/
avatar-video/.bin/

# Python bytecode
__pycache__/
*.pyc
